<% content_for :title, "Categories · BudgetShare" %>

<div class="flex items-center justify-between mb-4 gap-2 flex-wrap">
  <div class="flex items-center gap-2">
    <h1 class="text-xl font-bold">Categories</h1>
    <div class="join">
      <%= link_to "‹", categories_path(year: @year - 1), class: "btn btn-xs join-item" %>
      <span class="btn btn-xs join-item no-animation"><%= @year %></span>
      <%= link_to "›", categories_path(year: @year + 1), class: "btn btn-xs join-item" %>
    </div>
  </div>
  <%= link_to "+ Add category", new_category_path, data: { turbo_frame: "modal" },
        class: "btn btn-primary btn-sm" %>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <% if @categories.empty? %>
      <p class="text-base-content/60 text-sm py-4 text-center">
        No categories yet. Add one to start budgeting.
      </p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>Category</th><th class="text-right"><%= @year %> target</th><th></th></tr>
          </thead>
          <tbody>
            <% @categories.each do |category| %>
              <tr>
                <td><%= category_badge(category) %></td>
                <td class="text-right font-mono">
                  <%= cents_to_currency(category.budget_targets.where(year: @year).sum(:amount_cents)) %>
                </td>
                <td class="text-right whitespace-nowrap">
                  <%= link_to "Edit & targets", edit_category_path(category, year: @year),
                        class: "btn btn-ghost btn-xs" %>
                  <%= button_to "Delete", category_path(category), method: :delete,
                        class: "btn btn-ghost btn-xs text-error",
                        form: { data: { turbo_confirm: "Delete “#{category.name}”?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
