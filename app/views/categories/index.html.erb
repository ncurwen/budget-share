<% content_for :title, "Categories · BudgetShare" %>

<div class="flex items-center justify-between mb-4 gap-2 flex-wrap">
  <div class="flex items-center gap-2">
    <h1 class="text-xl font-bold">Categories</h1>
    <div class="join">
      <%= link_to "‹", categories_path(year: @year - 1), class: "btn btn-xs join-item" %>
      <span class="btn btn-xs join-item no-animation"><%= @year %></span>
      <%= link_to "›", categories_path(year: @year + 1), class: "btn btn-xs join-item" %>
    </div>
  </div>
  <%= link_to "+ Add category", new_category_path, data: { turbo_frame: "modal" },
        class: "btn btn-primary btn-sm" %>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <%= render TableComponent.new(
          collection: @categories,
          partial: "categories/category",
          as: :category,
          pagy: @pagy,
          hidden_params: { year: @year },
          search_config: {
            url: categories_path,
            attribute: :name_cont,
            value: params.dig(:q, :name_cont),
            placeholder: "Search categories..."
          },
          year: @year
        ) do |t| %>
      <% t.with_column { sort_link(@q, :name, "Category") } %>
      <% t.with_column(css_class: "text-right") { "#{@year} target" } %>
      <% t.with_column { "" } %>
      <% t.with_empty_message { "No categories yet. Add one to start budgeting." } %>
    <% end %>
  </div>
</div>
