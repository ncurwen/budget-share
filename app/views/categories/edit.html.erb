<% content_for :title, "Edit #{@category.name} · BudgetShare" %>

<div class="flex items-center gap-2 mb-4">
  <%= link_to "‹ Categories", categories_path(year: @year), class: "btn btn-ghost btn-sm" %>
  <h1 class="text-xl font-bold">Edit category</h1>
</div>

<%= form_with model: @category do |f| %>
  <%= render "shared/form_errors", record: @category %>

  <div class="card bg-base-100 shadow mb-4">
    <div class="card-body">
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="label" for="category_name">Name</label>
          <%= f.text_field :name, class: "input input-bordered w-full" %>
        </div>
        <div>
          <label class="label" for="category_color">Color</label>
          <%= f.select :color, Category::COLORS.map { |c| [ c.titleize, c ] },
                { include_blank: "Default" }, class: "select select-bordered w-full" %>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow mb-4">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 class="card-title text-base"><%= @year %> monthly targets</h2>
        <div class="join">
          <%= link_to "‹ #{@year - 1}", edit_category_path(@category, year: @year - 1), class: "btn btn-xs join-item" %>
          <%= link_to "#{@year + 1} ›", edit_category_path(@category, year: @year + 1), class: "btn btn-xs join-item" %>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mt-2">
        <%= f.fields_for :budget_targets, @targets do |tf| %>
          <div>
            <%= tf.hidden_field :year %>
            <%= tf.hidden_field :month %>
            <label class="label text-sm"><%= tf.object.month.capitalize %></label>
            <label class="input input-bordered flex items-center gap-1">
              <span class="text-base-content/50">$</span>
              <%= tf.number_field :amount, step: 0.01, min: 0, class: "grow", placeholder: "0.00" %>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", categories_path(year: @year), class: "btn btn-ghost" %>
    <%= f.submit "Save category", class: "btn btn-primary" %>
  </div>
<% end %>
