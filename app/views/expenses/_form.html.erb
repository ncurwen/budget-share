<%= form_with model: expense do |f| %>
  <%= render "shared/form_errors", record: expense %>

  <fieldset class="fieldset">
    <label class="label" for="expense_title">Title</label>
    <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "e.g. Costco run", autofocus: true %>

    <label class="label mt-2" for="expense_description">Description <span class="text-base-content/50">(optional)</span></label>
    <%= f.text_area :description, rows: 2, class: "textarea textarea-bordered w-full" %>

    <div class="grid grid-cols-2 gap-3 mt-2">
      <div>
        <label class="label" for="expense_amount">Amount</label>
        <%= f.number_field :amount, step: 0.01, min: 0, class: "input input-bordered w-full", placeholder: "0.00" %>
      </div>
      <div>
        <label class="label" for="expense_paid_on">Date paid</label>
        <%= f.date_field :paid_on, class: "input input-bordered w-full" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 mt-2">
      <div>
        <label class="label" for="expense_category_id">Category</label>
        <%= f.collection_select :category_id, current_household.categories, :id, :name,
              { prompt: "Select…" }, class: "select select-bordered w-full" %>
      </div>
      <div>
        <label class="label" for="expense_user_id">Paid by</label>
        <%= f.collection_select :user_id, current_household.users.order(:name), :id, :name,
              { prompt: "Select…" }, class: "select select-bordered w-full" %>
      </div>
    </div>

    <label class="label cursor-pointer justify-start gap-3 mt-3">
      <%= f.check_box :shared, class: "toggle toggle-primary" %>
      <span>Shared expense (split 50/50)</span>
    </label>

    <div class="modal-action">
      <button type="button" class="btn btn-ghost" data-action="dialog-component#close">Cancel</button>
      <%= f.submit expense.persisted? ? "Save" : "Add expense", class: "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>
