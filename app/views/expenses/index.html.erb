<% content_for :title, "Expenses · BudgetShare" %>

<%= render "shared/month_nav", date: @date,
      path_proc: ->(d) { expenses_path(year: d.year, month: d.month, q: params[:q]&.permit!) } %>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="flex justify-end items-center gap-2 flex-wrap mb-2">
      <%= link_to "+ Add expense", new_expense_path, data: { turbo_frame: "modal" },
            class: "btn btn-primary btn-sm" %>
    </div>

    <%= render TableComponent.new(
          collection: @expenses,
          partial: "expenses/expense",
          as: :expense,
          pagy: @pagy,
          hidden_params: { year: @date.year, month: @date.month },
          search_config: {
            url: expenses_path,
            attribute: :title_or_description_cont,
            value: params.dig(:q, :title_or_description_cont),
            placeholder: "Search expenses..."
          },
          filter_config: [
            {
              param: :shared_eq,
              active: params.dig(:q, :shared_eq),
              options: [
                { value: true,  label: "Shared",   icon: "users", color: "badge-info" },
                { value: false, label: "Personal", icon: "user",  color: "badge-ghost" }
              ]
            },
            {
              param: :category_id_eq,
              active: params.dig(:q, :category_id_eq),
              as: :select,
              prompt: "All categories",
              options: @categories.map { |c| { value: c.id, label: c.name } }
            }
          ]
        ) do |t| %>
      <% t.with_column { sort_link(@q, :paid_on, "Date") } %>
      <% t.with_column { sort_link(@q, :title, "Title") } %>
      <% t.with_column { "Category" } %>
      <% t.with_column { "Paid by" } %>
      <% t.with_column { "Split" } %>
      <% t.with_column(css_class: "text-right") { sort_link(@q, :amount_cents, "Amount") } %>
      <% t.with_column { "" } %>
      <% t.with_empty_message { "No expenses match." } %>
    <% end %>

    <% if @expenses.any? %>
      <div class="flex justify-end gap-3 items-baseline font-semibold mt-2 pr-2">
        <span class="text-base-content/60">Total</span>
        <span class="font-mono"><%= cents_to_currency(@total_cents) %></span>
      </div>
    <% end %>
  </div>
</div>
