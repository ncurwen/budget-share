<% content_for :title, "Account settings · BudgetShare" %>

<div class="max-w-md mx-auto">
  <h1 class="text-xl font-bold mb-4">Account settings</h1>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <label class="label" for="user_name">Name</label>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input input-bordered w-full" %>

          <label class="label mt-2" for="user_email">Email</label>
          <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full" %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-sm text-warning mt-1">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
          <% end %>

          <label class="label mt-2" for="user_password">
            New password <span class="text-base-content/50">(leave blank to keep current)</span>
          </label>
          <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>

          <label class="label mt-2" for="user_password_confirmation">Confirm new password</label>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>

          <label class="label mt-2" for="user_current_password">
            Current password <span class="text-base-content/50">(required to save)</span>
          </label>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input input-bordered w-full" %>

          <%= f.submit "Update", class: "btn btn-primary w-full mt-4" %>
        </fieldset>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow mt-4">
    <div class="card-body">
      <h2 class="card-title text-base text-error">Danger zone</h2>
      <p class="text-sm text-base-content/60">Permanently delete your account.</p>
      <div class="card-actions">
        <%= button_to "Cancel my account", registration_path(resource_name), method: :delete,
              class: "btn btn-error btn-sm", form: { data: { turbo_confirm: "Are you sure?" } } %>
      </div>
    </div>
  </div>
</div>
