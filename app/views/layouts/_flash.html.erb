<% if flash.any? %>
  <div class="toast toast-top toast-end z-50" data-controller="flash">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="alert <%= flash_alert_class(type) %> shadow-lg">
        <span><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>
