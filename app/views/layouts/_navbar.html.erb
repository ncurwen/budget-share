<div class="navbar bg-base-100 shadow-sm">
  <div class="container mx-auto max-w-5xl px-4">
    <div class="flex-1">
      <%= link_to "💸 BudgetShare", root_path, class: "btn btn-ghost text-xl" %>
      <div class="hidden sm:flex gap-1 ml-2">
        <%= link_to "Overview", root_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Expenses", expenses_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Categories", categories_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Year", year_path(Date.current.year), class: "btn btn-ghost btn-sm" %>
      </div>
    </div>

    <div class="flex-none gap-2">
      <%= link_to household_path, class: "btn btn-ghost btn-sm" do %>
        <span class="hidden sm:inline">🏠 <%= Current.household.name %></span>
        <span class="sm:hidden">🏠</span>
      <% end %>

      <%# User menu %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar avatar-placeholder">
          <div class="bg-neutral text-neutral-content w-9 rounded-full">
            <span class="text-sm"><%= Current.user.name.first&.upcase %></span>
          </div>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 mt-2 w-52 p-2 shadow">
          <li class="menu-title"><%= Current.user.name %></li>
          <li><button data-action="theme#toggle">🌓 Toggle theme</button></li>
          <li><%= link_to "Account settings", edit_user_registration_path %></li>
          <li><%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-error" %></li>
        </ul>
      </div>
    </div>
  </div>
</div>
