<% content_for :title, "New household · BudgetShare" %>

<div class="min-h-[70vh] flex items-center justify-center">
  <div class="card w-full max-w-sm bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="text-2xl font-bold text-center">Create a household</h1>
      <p class="text-center text-base-content/60 mb-2">
        A household is where you and your partner share expenses and budgets.
      </p>

      <%= form_with model: @household, url: household_path do |f| %>
        <%= render "shared/form_errors", record: @household %>

        <fieldset class="fieldset">
          <label class="label" for="household_name">Household name</label>
          <%= f.text_field :name, autofocus: true, class: "input input-bordered w-full",
                placeholder: "e.g. Alex & Sam" %>
          <%= f.submit "Create household", class: "btn btn-primary w-full mt-4" %>
        </fieldset>
      <% end %>
    </div>
  </div>
</div>
