<%# Renders block content inside a DaisyUI dialog within the "modal" Turbo Frame.
    Use via: render layout "shared/modal", locals title, with a block of body content. %>
<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal">
    <dialog data-modal-target="dialog" data-action="close->modal#close" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg mb-4"><%= title %></h3>
        <%= yield %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Close">close</button>
      </form>
    </dialog>
  </div>
<% end %>
