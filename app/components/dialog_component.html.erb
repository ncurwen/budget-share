<%# The dialog is always wrapped in a "dialog-component" controller element. It
    does not emit its own Turbo frame — turbo-loaded dialogs are rendered into
    the shared `turbo_frame_tag "modal"` declared by the layout/view, and the
    controller targets that frame by id. %>
<%= tag.div data: { controller: "dialog-component" } do %>
  <dialog class="modal<%= " #{@css_class}" if @css_class %>"
    data-dialog-component-target="dialog"
    data-dialog-auto-open="<%= @open %>"
    id="<%= @id %>">
    <div class="modal-box">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <% if title? %>
        <h3 class="text-lg font-bold mb-1"><%= title %></h3>
      <% end %>
      <% if @description %>
        <p class="text-base-content/60 text-sm mb-4"><%= @description %></p>
      <% end %>
      <%= body %>
      <% if footer? %>
        <div class="modal-action"><%= footer %></div>
      <% end %>
    </div>

    <% if @close_on_backdrop %>
      <form method="dialog" class="modal-backdrop">
        <button class="confirm-cancel">>close</button>
      </form>
    <% else %>
      <div class="modal-backdrop"></div>
    <% end %>
  </dialog>
<% end %>
